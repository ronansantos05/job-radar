# Copie para .env e preencha. O .env nunca vai para o Git.

# Chave da Groq: crie em https://console.groq.com/keys
GROQ_API_KEY=
# Modelo da Groq (veja os disponíveis em https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Login do dashboard. Use uma senha longa: o painel fica exposto na internet.
DASH_USER=admin
DASH_PASSWORD=

# Docker: em qual endereço publicar a porta. 127.0.0.1 = só a própria VPS (use com Caddy ou túnel SSH).
BIND=127.0.0.1
PORT=8000
# Seu domínio, se for usar o HTTPS automático (docker compose --profile https up -d)
DOMAIN=
