# Copie para .env e preencha. O .env nunca vai para o Git.

# Chave da Groq: crie em https://console.groq.com/keys
GROQ_API_KEY=
# Modelo da Groq (veja os disponíveis em https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Código de convite: quem tiver este código consegue criar uma conta em /cadastro.
# Sem ele, só a primeira conta (administradora) pode ser criada. Use um código longo.
SIGNUP_CODE=

# Docker: em qual endereço publicar a porta. 127.0.0.1 = só a própria VPS (use com Caddy ou túnel SSH).
BIND=127.0.0.1
PORT=8000
# Seu domínio, se for usar o HTTPS automático (docker compose --profile https up -d)
DOMAIN=

# Opcional, só para modelos que raciocinam (ex.: openai/gpt-oss-120b): low deixa a análise mais rápida.
# GROQ_REASONING_EFFORT=low
